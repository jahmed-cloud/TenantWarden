{
  "id": null,
  "uid": "tenantwarden-main",
  "title": "TenantWarden — Platform Overview",
  "tags": ["tenantwarden", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Active Alerts by Severity",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (severity) (tenantwarden_alerts_active_total)",
        "legendFormat": "{{severity}}"
      }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } }
      }
    },
    {
      "id": 2,
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(http_requests_total{job=\"tenantwarden-api\"}[5m])",
        "legendFormat": "{{method}} {{status_code}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "title": "Active Agents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "tenantwarden_agents_online_total",
        "legendFormat": "Online agents"
      }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Collection Cycle Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "tenantwarden_collection_duration_seconds",
        "legendFormat": "{{tenant}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Service Health",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "up{job=~\"tenantwarden.*\"}",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 6,
      "title": "Memory Usage — all services",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "process_resident_memory_bytes{job=~\"tenantwarden.*\"} / 1024 / 1024",
        "legendFormat": "{{job}}"
      }],
      "fieldConfig": { "defaults": { "unit": "MiB" } }
    }
  ],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {}
}
