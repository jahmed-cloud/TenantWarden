# Settings for deploy/docker-compose.yml. Copy to .env in the same folder.

# ── Secrets: required ─────────────────────────────────────────────────────────
# Use a different random value for each, e.g. `openssl rand -hex 32` (hex keeps them URL-safe).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
JWT_SIGNING_KEY=
# Encrypts the Microsoft Graph client secret of every tenant. Back it up: if it is lost,
# every tenant has to be connected again.
ENCRYPTION_KEY=

# ── Address ───────────────────────────────────────────────────────────────────
# How people reach the portal (used in notification links)
APP_URL=http://localhost:8090
# Name on the self-signed HTTPS certificate created on first start
TW_HOSTNAME=localhost
GATEWAY_HTTP_PORT=8090
GATEWAY_HTTPS_PORT=8443

# ── Version ───────────────────────────────────────────────────────────────────
TW_VERSION=1.0.0
# TW_IMAGE_PREFIX=docker.io/jahmed22/tenantwarden

# ── Microsoft Graph collection interval (seconds) ─────────────────────────────
COLLECTOR_INTERVAL=900

# ── Email notifications (optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@tenantwarden.local
