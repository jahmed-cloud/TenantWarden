{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://localhost"
  ],
  "App": {
    "Edition": "Enterprise",
    "Version": "1.0.0"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "tenantwarden",
      "Audience": "tenantwarden-api",
      "AccessTokenExpiryMinutes": 15,
      "RefreshTokenExpiryDays": 7
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topics": {
      "Events": "tenantwarden.events",
      "Alerts": "tenantwarden.alerts",
      "Metrics": "tenantwarden.metrics"
    }
  },
  "Hangfire": {
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire"
    }
  }
}