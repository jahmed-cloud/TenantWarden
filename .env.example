##############################################################################
# TenantWarden Enterprise — .env template
# Don't copy this file as-is: run `make setup-env` to generate a .env with
# fresh random secrets. Every CHANGE_ME value below must be replaced.
# For production: set real Azure credentials and use strong passwords.
##############################################################################

# ─── App ──────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
APP_EDITION=Enterprise
ENVIRONMENT=Development
BUILD_TARGET=production

# ─── Azure / Microsoft Entra ID ───────────────────────────────────────────
# Fill these in to connect real Microsoft 365 tenants (see make tenant-guide)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=placeholder-replace-with-real-secret
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_AUTHORITY=https://login.microsoftonline.com/common

# ─── JWT ──────────────────────────────────────────────────────────────────
# 96 hex chars (openssl rand -hex 48). Also signs agent enrollment tokens.
JWT_SIGNING_KEY=CHANGE_ME_JWT_SIGNING_KEY
JWT_ISSUER=tenantwarden
JWT_AUDIENCE=tenantwarden-api
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Gateway host ports (change if 8090/8443 are taken on this machine) ───
GATEWAY_HTTP_PORT=8090
GATEWAY_HTTPS_PORT=8443

# ─── URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost/api
AUTH_URL=http://localhost/auth
WS_URL=ws://localhost/ws
GRAFANA_URL=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=tenantwarden
POSTGRES_USER=tenantwarden
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_CONNECTION=Host=postgres;Database=tenantwarden;Username=tenantwarden;Password=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_URL=postgresql://tenantwarden:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/tenantwarden

# ─── ClickHouse ───────────────────────────────────────────────────────────
CLICKHOUSE_DB=tenantwarden_analytics
CLICKHOUSE_USER=tenantwarden
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CONNECTION=http://tenantwarden:CHANGE_ME_CLICKHOUSE_PASSWORD@clickhouse:8123/tenantwarden_analytics

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_CONNECTION=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ─── MinIO (object storage) ───────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# ─── Email (SMTP) — optional, leave blank for dev ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@tenantwarden.local

# ─── Notifications — optional, leave blank for dev ────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#security-alerts
PAGERDUTY_ROUTING_KEY=
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASS=
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# ─── AI / Analytics ───────────────────────────────────────────────────────
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Collector ────────────────────────────────────────────────────────────
COLLECTOR_INTERVAL=900
GRAPH_BATCH_SIZE=20

# ─── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ─── Agent gateway ────────────────────────────────────────────────────────
AGENT_GATEWAY_URL=ws://localhost:8082
AGENT_HEARTBEAT_INTERVAL=30
# Shared token for the gateway's internal /command and /agents endpoints.
# Leave blank to keep them disabled.
AGENT_INTERNAL_API_TOKEN=

# ─── Encryption ───────────────────────────────────────────────────────────
# 64 hex chars (openssl rand -hex 32). Back it up: losing it makes every
# stored tenant client secret unrecoverable.
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
